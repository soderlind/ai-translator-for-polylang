{
	"name": "soderlind/ai-translator-for-polylang",
	"description": "Create Polylang translations with the WordPress AI Client.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"AiTranslatorForPolylang\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AiTranslatorForPolylang\\Tests\\": "tests/php/"
		},
		"classmap": [
			"vendor/johnpbloch/wordpress-core/wp-includes/class-wp-token-map.php",
			"vendor/johnpbloch/wordpress-core/wp-includes/html-api/"
		]
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"johnpbloch/wordpress-core": "^6.9",
		"brain/monkey": "^2.6"
	},
	"scripts": {
		"test": "phpunit"
	}
}
